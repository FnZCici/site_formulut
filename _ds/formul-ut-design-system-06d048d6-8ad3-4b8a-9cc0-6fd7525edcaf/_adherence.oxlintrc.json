{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/site-vitrine/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Ethnocentric|Horizon|Montserrat))/i]",
        "message": "Font not provided by the design system. Available: Ethnocentric, Horizon, Montserrat."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|icon|iconPosition|fullWidth|disabled|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, icon, iconPosition, fullWidth, disabled, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|navy|outline|outline-ivory|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'navy' | 'outline' | 'outline-ivory' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Button> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onLight|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, onLight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|name|type|as|placeholder|required|hint|options|rows|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, name, type, as, placeholder, required, hint, options, rows, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|textarea|select)$/]",
        "message": "<Field> as must be one of 'input' | 'textarea' | 'select'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|onLight|style|key|ref|className|style|children)$/]",
        "message": "<FilterBar> doesn't accept that prop. Declared props: options, value, onChange, onLight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormStatus'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|children|style|key|ref|className|style|children)$/]",
        "message": "<FormStatus> doesn't accept that prop. Declared props: state, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormStatus'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|pending|success|error)$/]",
        "message": "<FormStatus> state must be one of 'idle' | 'pending' | 'success' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|label|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|action|onLight|style|key|ref|className|style|children)$/]",
        "message": "<IconCard> doesn't accept that prop. Declared props: icon, title, children, action, onLight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MemberCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|pole|photo|onLight|style|key|ref|className|style|children)$/]",
        "message": "<MemberCard> doesn't accept that prop. Declared props: name, role, pole, photo, onLight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonoplaceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|tag|tagTone|tagline|photo|photoAlt|specs|action|style|key|ref|className|style|children)$/]",
        "message": "<MonoplaceCard> doesn't accept that prop. Declared props: name, tag, tagTone, tagline, photo, photoAlt, specs, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonoplaceCard'] > JSXAttribute[name.name='tagTone'] > Literal[value!=/^(?:thermique|electrique|info|accent)$/]",
        "message": "<MonoplaceCard> tagTone must be one of 'thermique' | 'electrique' | 'info' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|excerpt|date|tag|tagTone|photo|photoAlt|href|linkLabel|featured|onLight|style|key|ref|className|style|children)$/]",
        "message": "<NewsCard> doesn't accept that prop. Declared props: title, excerpt, date, tag, tagTone, photo, photoAlt, href, linkLabel, featured, onLight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsCard'] > JSXAttribute[name.name='tagTone'] > Literal[value!=/^(?:thermique|electrique|info|accent)$/]",
        "message": "<NewsCard> tagTone must be one of 'thermique' | 'electrique' | 'info' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHero'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|accent|subtitle|actions|stats|style|key|ref|className|style|children)$/]",
        "message": "<PageHero> doesn't accept that prop. Declared props: eyebrow, title, accent, subtitle, actions, stats, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PerkPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|highlight|onLight|style|key|ref|className|style|children)$/]",
        "message": "<PerkPill> doesn't accept that prop. Declared props: children, highlight, onLight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|radius|scrim|grain|overlay|badge|style|key|ref|className|style|children)$/]",
        "message": "<PhotoFrame> doesn't accept that prop. Declared props: src, alt, ratio, radius, scrim, grain, overlay, badge, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pole'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|icon|summary|description|key|ref|className|style|children)$/]",
        "message": "<Pole> doesn't accept that prop. Declared props: name, icon, summary, description."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|subtitle|action|align|onLight|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: eyebrow, title, subtitle, action, align, onLight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeader> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|blurb|columns|socials|email|address|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: logoSrc, blurb, columns, socials, email, address, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|logoSrcOnLight|items|currentHref|ctaLabel|ctaHref|solid|onLight|style|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: logoSrc, logoSrcOnLight, items, currentHref, ctaLabel, ctaHref, solid, onLight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|layout|onLight|style|key|ref|className|style|children)$/]",
        "message": "<SpecList> doesn't accept that prop. Declared props: items, layout, onLight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecList'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:rows|inline)$/]",
        "message": "<SpecList> layout must be one of 'rows' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SponsorLogoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|href|placeholder|onLight|style|key|ref|className|style|children)$/]",
        "message": "<SponsorLogoCard> doesn't accept that prop. Declared props: src, name, href, placeholder, onLight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|suffix|label|animate|onLight|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: value, suffix, label, animate, onLight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepList'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|onLight|style|key|ref|className|style|children)$/]",
        "message": "<StepList> doesn't accept that prop. Declared props: steps, onLight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|onLight|icon|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, onLight, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:thermique|electrique|info|accent)$/]",
        "message": "<Tag> tone must be one of 'thermique' | 'electrique' | 'info' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|title|description|current|key|ref|className|style|children)$/]",
        "message": "<TimelineItem> doesn't accept that prop. Declared props: date, title, description, current."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|thickness|orientation|split|style|key|ref|className|style|children)$/]",
        "message": "<TrackRule> doesn't accept that prop. Declared props: tone, thickness, orientation, split, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackRule'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:yellow|red|hairline)$/]",
        "message": "<TrackRule> tone must be one of 'yellow' | 'red' | 'hairline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackRule'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<TrackRule> orientation must be one of 'horizontal' | 'vertical'."
      }
    ]
  },
